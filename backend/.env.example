# Database
DB_CONNECTION_STRING=mssql+pyodbc://sa:YourPassword@localhost:1433/SNMPortal?driver=ODBC+Driver+17+for+SQL+Server

# JWT
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Azure Blob Storage
AZURE_BLOB_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
AZURE_BLOB_CONTAINER=snm-assets

# CORS
CORS_ORIGINS=http://localhost:4200

# App
APP_NAME=SNM Portal
APP_VERSION=1.0.0
DEBUG=true

# ============================================================================
# KPI Studio (analytics module — see kpisetup.md for the full guide)
# ============================================================================

# DB connection used by the KPI executor for user-authored SQL.
# Defaults to DB_CONNECTION_STRING when blank. Recommended: a SELECT-only
# SQL Server login.
KPI_DSN=

# NL→SQL provider. One of: openai | azure_openai | gemini | cerebras | ollama_cloud
# Leave blank to disable the "Generate from prompt" feature; manual SQL
# authoring still works.
KPI_LLM_PROVIDER=openai

# OpenAI (the recommended starting point — also covers Cerebras + Ollama
# Cloud by changing KPI_LLM_PROVIDER and the matching keys below).
KPI_OPENAI_API_KEY=
KPI_OPENAI_MODEL=gpt-4o-mini
KPI_OPENAI_BASE_URL=https://api.openai.com/v1

# Azure OpenAI (alternative — fill these and set KPI_LLM_PROVIDER=azure_openai)
# KPI_AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
# KPI_AZURE_OPENAI_API_KEY=
# KPI_AZURE_OPENAI_DEPLOYMENT=gpt-4o
# KPI_AZURE_OPENAI_API_VERSION=2024-10-21
